<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC-dashboard</title>
  <link rel="stylesheet" href="/styles/dashboard.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
  <div class="main-dashboard">
    <div class="dh-menu">
      <div class="menu-links">
        <% if (users && users.role === 'admin') { %>
          <a href="/user">Manage User</a>
        <% } %>
        <a href="/add">Add Data</a>
        <a href="/manage-data">Manage Data</a>
        <% if (users && users.role === 'admin') { %>
          <a href="/activities">User Activities</a>
        <% } %>
        <a href="/map">Map</a>
        <a href="/logout">Logout</a>
      </div>
    </div>
    
    <div class="dh-nav-content">
      <div class="dh-nav">
        
        <form action="/upload-data" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
        <div style="margin-top: 16px; margin-right: 20px;" >
          <button type="button" onclick="document.getElementById('fileInput').click()">Upload</button>
          <input 
            type="file" 
            id="fileInput" 
            name="upload" 
            style="display: none;"
            accept=".csv, .xlsx, .xls"
          >
        </div> 
        </form>
      </div>
      <div class="event-data">
        <h1>IMS Data</h1>
        <form action="/events" method="post" class="event-form">
          <div class="form-grid">
            <div class="form-group" style="min-width: 80px; text-align: center;">
              <label for="id">ID</label>
              <input type="text" name="id" id="id" placeholder="Event ID" required>
            </div>

            <div class="form-group" style="min-width: 40px; text-align: center;">
              <label for="day">Day</label>
              <input type="text" name="day" id="day" placeholder="DD" required>
            </div>

            <div class="form-group" style="min-width: 40px; text-align: center;">
              <label for="Month">Month</label>
              <input type="text" name="month" id="month" placeholder="MM" required>
            </div>

            <div class="form-group" style="min-width: 60px; text-align: center;">
              <label for="minute">Minute</label>
              <input type="text" name="minute" id="minute" placeholder="00:00" required>
            </div>

            <div class="form-group" style="min-width: 100px; text-align: center;">
              <label for="second">Second</label>
              <input type="text" name="second" id="second" placeholder="00:00" required>
            </div>

            <div class="form-group" style="min-width: 40px; text-align: center;">
              <label for="Hour">Hour</label>
              <input type="text" name="hour" id="hour" placeholder="HR" required>
            </div>

            <div class="form-group" style="min-width: 150px; text-align: center;">
              <label for="latitude">Latitude</label>
              <input type="text" name="latitude" id="latitude" required>
            </div>

            <div class="form-group" style="min-width: 150px; text-align: center;">
              <label for="longitude">Longitude</label>
              <input type="text" name="longitude" id="longitude" required>
            </div>

            <div class="form-group" style="min-width: 50px; text-align: center;">
              <label for="H">H</label>
              <input type="text" name="H" id="H" required>
            </div>

            <div class="form-group" style="min-width: 50px; text-align: center;">
              <label for="Mb">Mb</label>
              <input type="text" name="Mb" id="Mb" required>
            </div>

            <div class="form-group" style="min-width: 50px; text-align: center;">
              <label for="Ml">Ml</label>
              <input type="text" name="Ml" id="Ml" required>
            </div>

            <div class="form-group" style="min-width:50px; text-align: center;">
              <label for="Az">Az</label>
              <input type="text" name="Az" id="Az" required>
            </div>

            <div class="form-group" style="min-width: 140px; text-align: center;">
              <label for="location">Location</label>
              <input type="text" name="location" id="location" required>
            </div>

            <div class="form-group" style="min-width: 160px; text-align: center;">
              <label for="nearest_location">Nearest Location</label>
              <input type="text" name="nearest_location" id="nearest_location" required>
            </div>
            
          </div>
          <div class="form-actions">
            <button type="submit">Submit Event</button>
          </div>
        </form>
      </div>
      
    </div>
  </div>
</body>

<script>
  const fileInput = document.getElementById('fileInput');
  const uploadForm = document.getElementById('uploadForm');

  fileInput.addEventListener('change', function () {
    if (fileInput.files.length > 0) {
      uploadForm.submit();
    }
  });
</script>
</html>