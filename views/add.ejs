<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC - Manage Data</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome for icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/styles/dashboard.css">
</head>
<body>
  <div class="main-dashboard">
    <!-- Collapsible Sidebar -->
    <div class="dh-menu" id="sidebar">
      <div class="menu-links">
        <% if (users && users.role === 'admin') { %>
          <a href="/user">Manage User</a>
        <% } %>
        <a href="/add">Add Data</a>
        <a href="/manage-data">Manage Data</a>
        <% if (users && users.role === 'admin') { %>
          <a href="/activities">User Activities</a>
        <% } %>
        <a href="/map" target="_blank">Map</a>
        <a href="/logout">Logout</a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="dh-nav-content" id="content">
      <!-- Navbar with Profile and Toggle -->
      <div class="dh-nav">
        <button class="btn btn-outline-light" id="toggleSidebar" aria-label="Toggle Sidebar">
          <i class="fas fa-bars"></i>
        </button>
        <div class="profile">
          <% if (users) { %>
            <img src="<%= users.image || '/images/default-profile.jpg' %>" alt="Profile Picture">
            <h5>Welcome, <%= users.user_name || 'Guest' %></h5>
          <% } else { %>
            <img src="/images/default-profile.jpg" alt="Profile Picture">
            <h5>Welcome, Guest</h5>
          <% } %>
        </div>
      </div>

      <!-- File Upload Form with Dropdown -->
      <form action="/upload-data" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
        <div class="form-group">
          <div class="dropdown">
            <button class="event-form-button dropdown-toggle" type="button" id="uploadDropdown" style="background-color: hsl(207, 91%, 55%);" data-bs-toggle="dropdown" aria-expanded="false">
              Upload Data
            </button>
            <ul class="dropdown-menu" aria-labelledby="uploadDropdown">
              <li><a class="dropdown-item" href="#" onclick="document.getElementById('fileInput').click()">Upload File</a></li>
              <li><a class="dropdown-item" href="/download-template-csv">Download CSV Template</a></li>
              <li><a class="dropdown-item" href="/download-template-excel">Download Excel Template</a></li>
            </ul>
            <input 
              type="file" 
              id="fileInput" 
              name="upload" 
              style="display: none;"
              accept=".csv, .xlsx, .xls"
            >
          </div>
        </div>
      </form>

      <!-- SHI Data Form -->
      <div class="event-data">
        <h1>SHI Data</h1>
        <form action="/events" method="post" class="event-form">
          <div class="scroll-wrapper">
            <div class="form-grid">
              <div class="form-group">
                <label for="id">ID</label>
                <input type="text" name="id" id="id" placeholder="Event ID" required style="width: 80px;">
              </div>
              <div class="form-group">
                <label for="year">Year</label>
                <input type="text" name="year" id="year" placeholder="0000" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="day">Day</label>
                <input type="text" name="day" id="day" placeholder="DD" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="month">Month</label>
                <input type="text" name="month" id="month" placeholder="MM" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="minute">Minute</label>
                <input type="text" name="minute" id="minute" placeholder="00:00" required style="width: 80px;">
              </div>
              <div class="form-group">
                <label for="second">Second</label>
                <input type="text" name="second" id="second" placeholder="00:00" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="hour">Hour</label>
                <input type="text" name="hour" id="hour" placeholder="HR" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="latitude">Latitude</label>
                <input type="text" name="latitude" id="latitude" required style="width: 100px;">
              </div>
              <div class="form-group">
                <label for="longitude">Longitude</label>
                <input type="text" name="longitude" id="longitude" required style="width: 100px;">
              </div>
              <div class="form-group">
                <label for="H">H</label>
                <input type="text" name="H" id="H" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="Mb">Mb</label>
                <input type="text" name="Mb" id="Mb" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="Ml">Ml</label>
                <input type="text" name="Ml" id="Ml" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="Az">Az</label>
                <input type="text" name="Az" id="Az" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="location">Location</label>
                <input type="text" name="location" id="location" required style="width: 170px;">
              </div>
              <div class="form-group">
                <label for="nearest_location">Nearest Location</label>
                <input type="text" name="nearest_location" id="nearest_location" required style="width: 170px;">
              </div>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit">Submit Event</button>
          </div>
        </form>
      </div>

      <!-- Radionuclide Data Form -->
      <div class="event-data">
        <h1>Radionuclide Data</h1>
        <form action="/radionuclide" method="post" class="event-form">
          <div class="scroll-wrapper">
            <div class="form-grid">
              <div class="form-group">
                <label for="day">Day</label>
                <input type="text" name="day" id="day" placeholder="DD" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="year">Year</label>
                <input type="text" name="year" id="year" placeholder="0000" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="month">Month</label>
                <input type="text" name="month" id="month" placeholder="MM" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="minute">Minute</label>
                <input type="text" name="minute" id="minute" placeholder="00:00" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="seconds">Seconds</label>
                <input type="text" name="seconds" id="seconds" placeholder="00:00" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="hour">Hour</label>
                <input type="text" name="hour" id="hour" placeholder="HR" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="latitude">Latitude</label>
                <input type="text" name="latitude" id="latitude" required style="width: 120px;">
              </div>
              <div class="form-group">
                <label for="longitude">Longitude</label>
                <input type="text" name="longitude" id="longitude" required style="width: 120px;">
              </div>
              <div class="form-group">
                <label for="depth_h">Depth</label>
                <input type="text" name="depth_h" id="depth_h" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="Mb">Mb</label>
                <input type="text" name="Mb" id="Mb" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="Ml">Ml</label>
                <input type="text" name="Ml" id="Ml" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="Azimuth">Az</label>
                <input type="text" name="Azimuth" id="Azimuth" required style="width: 60px;">
              </div>
              <div class="form-group">
                <label for="location">Location</label>
                <input type="text" name="location" id="location" required style="width: 200px;">
              </div>
              <div class="form-group">
                <label for="nearest_location">Nearest Location</label>
                <input type="text" name="nearest_location" id="nearest_location" required style="width: 200px;">
              </div>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit">Submit Event</button>
          </div>
        </form>
      </div>
     </div>
   </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Toggle Sidebar
    const toggleSidebar = document.getElementById('toggleSidebar');
    const sidebar = document.getElementById('sidebar');
    const content = document.getElementById('content');
    toggleSidebar.addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
      content.classList.toggle('collapsed');
    });

    // File Upload
    const fileInput = document.getElementById('fileInput');
    const uploadForm = document.getElementById('uploadForm');
    fileInput.addEventListener('change', function () {
      if (fileInput.files.length > 0) {
        uploadForm.submit();
      }
    });
  </script>
</body>
</html>