<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC-dashboard</title>
  <link rel="stylesheet" href="/styles/dashboard.css">
</head>
<body>
  <div class="main-dashboard">
    <div class="dh-menu">
      <div>
        <a href="/dashboard">Dashboard</a>
        <a href="/user">Manage User</a>
        <a href="/add">Add Data</a>
        <a href="/manage-data">Manage Data</a>
        <a href="/activities">User Activites</a>
        <a href="/map">MAP</a>
        <a href="/logout">LOGOUT</a>
      </div>
     
    </div>
    <div class="dh-nav-content">
      <div class="dh-nav">
      </div>
      <h2>User Activity Logs</h2>
      <table>
        <thead>
          <tr>
            <th>User ID</th>
            <th>Email</th>
            <th>Action</th>
            <th>Details</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(log => { %>
            <tr>
              <td><%= log.user_id %></td>
              <td><%= log.user_email %></td>
              <td><%= log.action %></td>
              <td><%= log.details %></td>
              <td><%= log.timestamp %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      
        </div>
      </div>
    </div>
  </div>
</body>
</html>