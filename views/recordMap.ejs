<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC Add Data</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/styles/dashboard.css">
  <style>
    .map-container {
      position: relative;
      height: 430px;
      margin-bottom: 20px;
    }
    #map {
      height: 100%;
    }
    #coords {
      position: absolute;
      bottom: 20px;
      left: 10px;
      background: hsla(240, 69%, 56%, 0.5);
      padding: 4px 8px;
      border-radius: 4px;
      font-family: Arial, sans-serif;
      font-size: 12px;
      z-index: 1000;
      max-width: 300px;
      color: white;
    }
    .add-form {
      max-width: 1200px; /* Increased width to accommodate horizontal layout */
      margin: 0 auto;
    }
    .form-row {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap; /* Allow wrapping for responsiveness */
      gap: 10px; /* Reduced gap for tighter horizontal layout */
      justify-content: space-between; /* Distribute space evenly */
    }
    .form-group {
      flex: 1;
      min-width: 120px; /* Minimum width to prevent inputs from being too narrow */
      max-width: 150px; /* Limit width for better fit */
    }
    .form-group input,
    .form-group select {
      width: 100%;
      font-size: 14px; /* Slightly smaller font for compact layout */
    }
    .form-group label {
      font-size: 14px;
    }
    .submit-btn {
      width: 100%;
      max-width: 200px; /* Limit button width */
      margin: 20px auto; /* Center button */
      display: block;
    }
    @media (max-width: 768px) {
      .form-row {
        flex-direction: column; /* Stack vertically on small screens */
        gap: 15px;
      }
      .form-group {
        min-width: 100%; /* Full width on mobile */
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="main-dashboard">
    <div class="dh-menu" id="sidebar">
      <div class="menu-links">
        <a href="/home">Home</a>
        <% if (users && users.role === 'admin') { %>
          <a href="/user">Manage User</a>
        <% } %>
        <a href="/add" class="active">Add Data</a>
        <a href="/manage-data">Manage Data</a>
        <% if (users && users.role === 'admin') { %>
          <a href="/activities">User Logs</a>
        <% } %>
        <a href="/map" target="_blank">Map</a>
        <a href="/library">Library</a>
        <a href="/recordMap">Record Data</a>
        <a href="/logout">Logout</a>
      </div>
    </div>

    <div class="dh-nav-content" id="content">
      <div class="dh-nav">
        <button class="btn btn-outline-light" id="toggleSidebar" aria-label="Toggle Sidebar">
          <i class="fas fa-bars"></i>
        </button>
        <div class="profile">
          <img src="<%= users && users.image ? users.image : '/images/default-profile.jpg' %>" alt="Profile Picture">
          <h5>Welcome, <%= users && users.username ? users.username : 'Guest' %></h5>
        </div>
      </div>

      <div class="dh-content">
        <form action="/events" method="POST" class="add-form">
          <div class="map-container">
            <div id="map"></div>
            <div id="coords">Click on the map to pick coordinates and location</div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="id">ID</label>
              <input type="text" class="form-control" id="id" name="id" required>
            </div>
            <div class="form-group">
              <label for="year">Year</label>
              <input type="number" class="form-control" id="year" name="year" required>
            </div>
            <div class="form-group">
              <label for="month">Month</label>
              <input type="text" class="form-control" id="month" name="month" required>
            </div>
            <div class="form-group">
              <label for="day">Day</label>
              <input type="number" class="form-control" id="day" name="day" required>
            </div>
            <div class="form-group">
              <label for="hour">Hour</label>
              <input type="number" class="form-control" id="hour" name="hour" required>
            </div>
            <div class="form-group">
              <label for="minute">Minute</label>
              <input type="number" class="form-control" id="minute" name="minute" required>
            </div>
            <div class="form-group">
              <label for="second">Second</label>
              <input type="number" class="form-control" id="second" name="second" step="0.1" required>
            </div>
            <div class="form-group">
              <label for="latitude">Latitude</label>
              <input type="number" class="form-control" id="latitude" name="latitude" step="0.00001" required readonly>
            </div>
            <div class="form-group">
              <label for="longitude">Longitude</label>
              <input type="number" class="form-control" id="longitude" name="longitude" step="0.00001" required readonly>
            </div>
            <div class="form-group">
              <label for="H">Depth (H)</label>
              <input type="number" class="form-control" id="H" name="H" step="0.1" required>
            </div>
            <div class="form-group">
              <label for="Mb">Mb</label>
              <input type="number" class="form-control" id="Mb" name="Mb" step="0.1" required>
            </div>
            <div class="form-group">
              <label for="Ml">Ml</label>
              <input type="number" class="form-control" id="Ml" name="Ml" step="0.1">
            </div>
            <div class="form-group">
              <label for="Az">Azimuth (Az)</label>
              <input type="number" class="form-control" id="Az" name="Az" required>
            </div>
            <div class="form-group">
              <label for="location">Location (Country)</label>
              <input type="text" class="form-control" id="location" name="location" required>
            </div>
            <div class="form-group">
              <label for="nearest_location">Nearest Location</label>
              <input type="text" class="form-control" id="nearest_location" name="nearest_location" required>
            </div>
          </div>
          <button type="submit" class="btn btn-primary mt-4 submit-btn">Add Event</button>
        </form>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

  <script>
    // Sidebar toggle
    const toggleSidebar = document.getElementById('toggleSidebar');
    const sidebar = document.getElementById('sidebar');
    const content = document.getElementById('content');

    function hideSidebar() {
      sidebar.classList.add('collapsed');
      content.classList.add('collapsed');
    }

    let autoHideTimeout;
    function resetAutoHideTimer() {
      clearTimeout(autoHideTimeout);
      autoHideTimeout = setTimeout(hideSidebar, 15000);
    }

    resetAutoHideTimer();

    sidebar.addEventListener('mouseenter', resetAutoHideTimer);
    sidebar.addEventListener('mouseleave', resetAutoHideTimer);

    toggleSidebar.addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
      content.classList.toggle('collapsed');
      resetAutoHideTimer();
    });

    // Initialize map centered on Ghana/Africa
    const map = L.map('map').setView([7.9465, -1.0232], 6); // Center on Ghana
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

    let marker;
    const geocoder = L.Control.geocoder({
      defaultMarkGeocode: false
    }).on('markgeocode', function(e) {
      const center = e.geocode.center;
      const name = e.geocode.name || 'Unknown location';
      map.fitBounds(e.geocode.bbox);
      if (marker) {
        marker.setLatLng(center);
      } else {
        marker = L.marker(center).addTo(map);
      }
      document.getElementById('latitude').value = center.lat.toFixed(5);
      document.getElementById('longitude').value = center.lng.toFixed(5);
      document.getElementById('coords').innerText = `Latitude: ${center.lat.toFixed(5)}, Longitude: ${center.lng.toFixed(5)}, Location: ${name}`;
      
      // Extract country and nearest location from geocoding result
      const address = e.geocode.properties.address || {};
      const country = address.country || 'Unknown';
      const nearest = address.city || address.town || address.village || address.hamlet || address.suburb || address.neighbourhood || e.geocode.name || 'Unknown';
      
      document.getElementById('location').value = country;
      document.getElementById('nearest_location').value = nearest;
      marker.bindPopup(`<strong>Country:</strong> ${country}<br><strong>Nearest:</strong> ${nearest}<br>Latitude: ${center.lat.toFixed(5)}<br>Longitude: ${center.lng.toFixed(5)}`).openPopup();
    }).addTo(map);

    map.on('click', function(e) {
      const { lat, lng } = e.latlng;
      document.getElementById('latitude').value = lat.toFixed(5);
      document.getElementById('longitude').value = lng.toFixed(5);
      document.getElementById('coords').innerText = `Latitude: ${lat.toFixed(5)}, Longitude: ${lng.toFixed(5)}, Fetching location...`;

      if (marker) {
        marker.setLatLng(e.latlng);
      } else {
        marker = L.marker(e.latlng).addTo(map);
      }

      L.Control.Geocoder.nominatim().reverse(e.latlng, map.options.crs.scale(map.getZoom()), function(results) {
        try {
          if (results && results.length > 0) {
            const result = results[0];
            const address = result.properties?.address || {};
            const country = address.country || result.name || 'Unknown';
            const nearest = address.city || address.town || address.village || address.hamlet || address.suburb || address.neighbourhood || result.name || 'Unknown';

            document.getElementById('location').value = country;
            document.getElementById('nearest_location').value = nearest;
            document.getElementById('coords').innerText = `Latitude: ${lat.toFixed(5)}, Longitude: ${lng.toFixed(5)}, Country: ${country}, Nearest: ${nearest}`;
            marker.bindPopup(`<strong>Country:</strong> ${country}<br><strong>Nearest:</strong> ${nearest}<br>Latitude: ${lat.toFixed(5)}<br>Longitude: ${lng.toFixed(5)}`).openPopup();
          } else {
            document.getElementById('location').value = '';
            document.getElementById('nearest_location').value = '';
            document.getElementById('coords').innerText = `Latitude: ${lat.toFixed(5)}, Longitude: ${lng.toFixed(5)}, Location: Unknown`;
            marker.bindPopup(`Latitude: ${lat.toFixed(5)}<br>Longitude: ${lng.toFixed(5)}<br>Location: Unknown`).openPopup();
            console.warn('No geocoding results found for coordinates:', lat, lng);
          }
        } catch (error) {
          console.error('Error processing geocoding results:', error);
          document.getElementById('location').value = '';
          document.getElementById('nearest_location').value = '';
          document.getElementById('coords').innerText = `Latitude: ${lat.toFixed(5)}, Longitude: ${lng.toFixed(5)}, Location: Error fetching location`;
          marker.bindPopup(`Latitude: ${lat.toFixed(5)}<br>Longitude: ${lng.toFixed(5)}<br>Location: Error`).openPopup();
        }
      }, function(error) {
        console.error('Geocoding request failed:', error);
        document.getElementById('location').value = '';
        document.getElementById('nearest_location').value = '';
        document.getElementById('coords').innerText = `Latitude: ${lat.toFixed(5)}, Longitude: ${lng.toFixed(5)}, Location: Geocoding failed`;
        marker.bindPopup(`Latitude: ${lat.toFixed(5)}<br>Longitude: ${lng.toFixed(5)}<br>Location: Geocoding failed`).openPopup();
      });
    });
  </script>
</body>
</html>