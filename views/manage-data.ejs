<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC-dashboard</title>
 
  <link rel="stylesheet" href="/styles/dashboard.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

</head>
<body>
  <div class="main-dashboard">
    <div class="dh-menu">
      <div class="menu-links">
         <% if (users && users.role === 'admin') { %>
          <a href="/user">Manage User</a>
        <% } %>

        <a href="/add">Add Data</a>

        <a href="/manage-data">Manage Data</a>

         <% if (users && users.role === 'admin') { %>
          <a href="/activities">User Activities</a>
        <% } %>

        <a href="/map">Map</a>

        <a href="/logout">Logout</a>
      </div>
    </div>
    <div class="dh-nav-content">
      <div class="dh-nav">
        <a href="/download" class="btn btn-primary">📥 Download in (CSV) format</a>
        <a href="/download-excel" class="btn btn-success">📊 Download as Excel format</a>


        <form action="/upload-data" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
          <div style="margin-top: 16px; margin-right: 20px;" >
            <button type="button" onclick="document.getElementById('fileInput').click()">Upload</button>
            <input 
              type="file" 
              id="fileInput" 
              name="upload" 
              style="display: none;"
              accept=".csv, .xlsx, .xls"
            >
          </div>
          
        </form>

      </div>



      <form action="/search" method="get" class="manage-data">
        <div class="input-group">
         <select name="column" class="form-select">
          <option value="">All Columns</option>
          <option value="id">ID</option>
          <option value="day">Day</option>
          <option value="mm">Month</option>
          <option value="minute">Minute</option>
          <option value="second">Second</option>
          <option value="hr">Hour</option>
          <option value="latitude">Latitude</option>
          <option value="longitude">Longitude</option>
          <option value="h">Depth (H)</option>
          <option value="mb">Mb</option>
          <option value="ml">Ml</option>
          <option value="az">Azimuth (Az)</option>
          <option value="location">Location</option>
          <option value="nearest_location">Nearest Location</option>
         </select>
            <input
              type="text"
              name="query"
              class="form-control"
              placeholder="Search..."
              value="<%= query || '' %>"
            />
            <button type="submit" class="primary">Search</button>
        </div>
      </form>
      <div class="atv-tb" id="atv">
      <table border="1">
        <thead>
          <tr>
            <th>ID</th>
            <th>Month</th>
            <th>Day</th>
            <th>Hour</th>
            <th>Minute</th>
            <th>Second</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>H</th>
            <th>Mb</th>
            <th>Ml</th>
            <th>Az</th>
            <th>Location</th>
            <th>Nearest_Location</th>
            <th>DELETE</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(data => { %>
            <tr> 
              <td><%= data.id %></td>
              <td><%= data.mm %></td>
              <td><%= data.day %></td>
              <td><%= data.hr %></td>
              <td><%= data.minute %></td>
              <td><%= data.second %></td>
              <td><%= data.latitude %></td>
              <td><%= data.longitude %></td>
              <td><%= data.h %></td>
              <td><%= data.mb %></td>
              <td><%= data.ml %></td>
              <td><%= data.az %></td>
              
              <td>
                <a style="font-size: 20px;" href="/map?lat=<%= data.latitude %>&lng=<%= data.longitude %>" target="_blank">
                  <%= data.location %>
                </a>
              </td>
              
              <td><%= data.nearest_location %></td>
              <td>
                <form action="/data/<%= data.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this row?');">
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
          
        </tbody>
        
      </table>
      </div>
    </div>
</body>
</html>

<script>
  const Scroll = document.getElementById('atv');
  Scroll.scrollTop = Scroll.scrollHeight;

  
  const fileInput = document.getElementById('fileInput');
  const uploadForm = document.getElementById('uploadForm');

  fileInput.addEventListener('change', function () {
    if (fileInput.files.length > 0) {
      uploadForm.submit();
    }
  });
</script>