<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC-dashboard</title>
 
  <link rel="stylesheet" href="/styles/dashboard.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  

</head>
<body>
  <div class="main-dashboard">
    <div class="dh-menu" id="sidebar">
      <div class="menu-links">
         <% if (users && users.role === 'admin') { %>
          <a href="/user">Manage User</a>
        <% } %>

        <a href="/add">Add Data</a>

        <a href="/manage-data">Manage Data</a>

         <% if (users && users.role === 'admin') { %>
          <a href="/activities">User Logs</a>
        <% } %>

        <a href="/map" target="_blank">Map</a>
        <a href="/library" class="active">Library</a>
        <a href="/logout">Logout</a>
      </div>
    </div>
    <div class="dh-nav-content" id="content">

      <div class="dh-nav">
        <button class="btn btn-outline-light" id="toggleSidebar" aria-label="Toggle Sidebar">
          <i class="fas fa-bars"></i>
        </button>
        <div class="profile">
          <% if (users) { %>
            <img src="<%= users.image || '/images/default-profile.jpg' %>" alt="Profile Picture">
            <h5>Welcome, <%= users.username || 'Guest' %></h5>
          <% } else { %>
            <img src="/images/default-profile.jpg" alt="Profile Picture">
            <h5>Welcome, Guest</h5>
          <% } %>
        </div>
       

      </div>



            <!-- File Upload Form with Dropdown -->
      <form action="/upload-data" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
        <div class="form-group">
          <div class="dropdown">
            <button class="event-form-button dropdown-toggle" type="button" id="uploadDropdown" style="background-color: hsl(207, 91%, 55%);" data-bs-toggle="dropdown" aria-expanded="false">
              Upload Data
            </button>
            <ul class="dropdown-menu" aria-labelledby="uploadDropdown">
              <li><a class="dropdown-item" href="#" onclick="document.getElementById('fileInput').click()">Upload File</a></li>
              <li><a class="dropdown-item" href="/download-template-csv">Download CSV Template</a></li>
              <li><a class="dropdown-item" href="/download-template-excel">Download Excel Template</a></li>
              <li>       <a href="/download" class="btn btn-primary">📥 Download in (CSV) format</a>
              </li>
              <li>        <a href="/download-excel" class="btn btn-success">📊 Download as Excel format</a>
              </li>
            </ul>
            <input 
              type="file" 
              id="fileInput" 
              name="upload" 
              style="display: none;"
              accept=".csv, .xlsx, .xls"
            >
          </div>
        </div>
      </form>
`

      <form action="/search" method="get" class="manage-data">
        <div class="input-group">
         <select name="column" class="form-select">
          <option value="">All Columns</option>
          <option value="id">ID</option>
          <option value="year">Year</option>
          <option value="day">Day</option>
          <option value="mm">Month</option>
          <option value="minute">Minute</option>
          <option value="second">Second</option>
          <option value="hr">Hour</option>
          <option value="latitude">Latitude</option>
          <option value="longitude">Longitude</option>
          <option value="h">Depth (H)</option>
          <option value="mb">Mb</option>
          <option value="ml">Ml</option>
          <option value="az">Azimuth (Az)</option>
          <option value="location">Location</option>
          <option value="nearest_location">Nearest Location</option>
         </select>
            <input
              type="text"
              name="query"
              class="form-control"
              placeholder="Search..."
              value="<%= query || '' %>"
            />
            <button type="submit" class="primary">Search</button>
        </div>
      </form>
      <div class="atv-tb" id="atv">
      <table border="1">
        <thead>
          <tr>
            <th>ID</th>
            <th>Year</th>
            <th>Month</th>
            <th>Day</th>
            <th>Hour</th>
            <th>Minute</th>
            <th>Second</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>H</th>
            <th>Mb</th>
            <th>Ml</th>
            <th>Az</th>
            <th>Location</th>
            <th>Nearest_Location</th>
            <th>DELETE</th>

          </tr>
        </thead>
        <tbody>
          <% data.forEach(data => { %>
            <tr> 
              <td><%= data.id %></td>
              <td><%= data.year %></td>
              <td><%= data.mm %></td>
              <td><%= data.day %></td>
              <td><%= data.hr %></td>
              <td><%= data.minute %></td>
              <td><%= data.second %></td>
              <td><%= data.latitude %></td>
              <td><%= data.longitude %></td>
              <td><%= data.h %></td>
              <td><%= data.mb %></td>
              <td><%= data.ml %></td>
              <td><%= data.az %></td>
              
              <td>
                <a style="font-size: 20px;" href="/map?lat=<%= data.latitude %>&lng=<%= data.longitude %>" target="_blank">
                  <%= data.location %>
                </a>
              </td>
              
              <td>
                <a href="/map?lat=<%= data.latitude %>&lng=<%= data.longitude %>" target="_blank">
                    <%= data.nearest_location || 'Unknown' %>
                  </a>
              </td>
                
              <td>
                <form action="/data/<%= data.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this row?');">
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
          
        </tbody>
        
      </table>
      </div>
    </div>
</body>
</html>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>

   // Toggle Sidebar
    const toggleSidebar = document.getElementById('toggleSidebar');
    const sidebar = document.getElementById('sidebar');
    const content = document.getElementById('content');

    function hideSidebar() {
    sidebar.classList.add('collapsed');
    content.classList.add('collapsed');
  }

    let autoHideTimeout;
  function resetAutoHideTimer() {
    clearTimeout(autoHideTimeout); // Clear any existing timer
    autoHideTimeout = setTimeout(hideSidebar, 15000); // Set new timer for 15 seconds
  }

    resetAutoHideTimer();

    sidebar.addEventListener('mouseenter', resetAutoHideTimer);
    sidebar.addEventListener('mouseleave', resetAutoHideTimer);

    toggleSidebar.addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
      content.classList.toggle('collapsed');
      resetAutoHideTimer();
    });


  const Scroll = document.getElementById('atv');
  Scroll.scrollTop = Scroll.scrollHeight;

  
  const fileInput = document.getElementById('fileInput');
  const uploadForm = document.getElementById('uploadForm');

  fileInput.addEventListener('change', function () {
    if (fileInput.files.length > 0) {
      uploadForm.submit();
    }
  });
</script>