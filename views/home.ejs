<%- include("partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/home.css">
  <title>GAEC</title>
</head>
<body>
  <div class="home">
    <div class="home-content">
  <div class="form-container">
     <!-- Feedback Messages -->
     <% if (success) { %>
      <div style="
        padding: 12px 16px;
        background-color: #d4edda;
        color: #155724;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
        border-radius: 6px;
        font-weight: 500;
        font-family: sans-serif;
      ">
        ✅ <%= success %>
      </div>
    <% } %>

    <% if (error) { %>
      <div style="
        padding: 12px 16px;
        background-color: #f8d7da;
        color: #721c24;
        margin-bottom: 20px;
        border: 1px solid #f5c6cb;
        border-radius: 6px;
        font-weight: 500;
        font-family: sans-serif;
      ">
        ❌ <%= error %>
      </div>
    <% } %>
    <form action="/submit" method="post" class="styled-form">
      <h2>LOGIN</h2>
      <label for="id">ID</label>
      <input type="id" name="is" id="is" required>
      <label for="email">EMAIL</label>
      <input type="email" name="email" id="email" placeholder="Enter valid email">
      <label for="password">PASSCODE</label>
      <input type="password" name="password" id="pass" placeholder="Enter Password">
      <input type="checkbox" onclick="myFunction()" >Show Password

      <div style="margin-top: 8px; margin-bottom: 16px;">
        <a href="/forgot-password" style="font-size: 14px; color: #007BFF; text-decoration: none;">Forgot Password?</a>
      </div>
      
      <div class="checkbox-container">
        <input type="checkbox" name="checkbox" id="check" required>
        <br><br>
        <label for="checkbox">Check to agree to terms</label>
      </div>
      <button type="submit">SUBMIT</button>
    </form>
  </div>
  </div>
</div>
</body>
</html>

<script>
  function myFunction() {
  var x = document.getElementById("pass");
  if (x.type === "password") {
    x.type = "text";
  } else {
    x.type = "password";
  }
}
</script>
<%- include("partials/footer.ejs") %>