<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NDC-GAEC Library</title>
  <link rel="stylesheet" href="/styles/dashboard.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="main-dashboard">
    <div class="dh-menu" id="sidebar">
      <div class="menu-links">
        <% if (users && users.role === 'admin') { %>
          <a href="/user">Manage User</a>
        <% } %>
        <a href="/add">Add Data</a>
        <a href="/manage-data">Manage Data</a>
        <% if (users && users.role === 'admin') { %>
          <a href="/activities">User Activities</a>
        <% } %>
        <a href="/map" target="_blank">Map</a>
        <a href="/library" class="active">Library</a>
        <a href="/logout">Logout</a>
      </div>
    </div>
    <div class="dh-nav-content" id="content">
      <div class="dh-nav">
        <button class="btn btn-outline-light" id="toggleSidebar" aria-label="Toggle Sidebar">
          <i class="fas fa-bars"></i>
        </button>
        <div class="profile">
          <% if (users) { %>
            <img src="<%= users.image || '/images/default-profile.jpg' %>" alt="Profile Picture">
            <h5>Welcome, <%= users.username || 'Guest' %></h5>
          <% } else { %>
            <img src="/images/default-profile.jpg" alt="Profile Picture">
            <h5>Welcome, Guest</h5>
          <% } %>
        </div>
      </div>

      <!-- File Upload Form -->
      <% if( users && users.role === 'admin'){ %>
      <form action="/upload-file" method="POST" enctype="multipart/form-data" class="upload-form" id="uploadForm">
        <div class="form-group">
          <div class="dropdown">
            <button class="event-form-button dropdown-toggle" type="button" id="uploadDropdown" style="background-color: hsl(207, 91%, 55%);" data-bs-toggle="dropdown" aria-expanded="false">
              Upload File
            </button>
            <ul class="dropdown-menu" aria-labelledby="uploadDropdown">
              <li><a class="dropdown-item" href="#" onclick="document.getElementById('fileInput').click()">Upload File</a></li>
            </ul>
            <input 
              type="file" 
              id="fileInput" 
              name="upload" 
              style="display: none;"
              accept=".csv, .xlsx, .xls, .pdf, .doc, .docx"
            >
          </div>
        </div>
      </form>
    <%}%>

      <!-- File List Table -->
      <div class="atv-tb" id="fileList">
        <table border="1">
          <thead>
            <tr>
              <th>File Name</th>
              <th>Upload Date</th>
              <th>File Type</th>
              <th>Size</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% files && files.forEach(file => { %>
              <tr>
                <td><%= file.name %></td>
                <td><%= file.upload_date %></td>
                <td><%= file.type %></td>
                <td><%= file.size %></td>
                <td>
                  <a href="/download-file/<%= file.id %>" class="btn btn-sm btn-primary">
                    <i class="fas fa-download"></i> Download
                  </a>
                  <% if (users && users.role === 'admin') { %>
                    <form action="/delete-file/<%= file.id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this file?');">
                      <button type="submit" class="btn btn-sm btn-danger">
                        <i class="fas fa-trash"></i> Delete
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Toggle Sidebar
    const toggleSidebar = document.getElementById('toggleSidebar');
    const sidebar = document.getElementById('sidebar');
    const content = document.getElementById('content');

    function hideSidebar() {
      sidebar.classList.add('collapsed');
      content.classList.add('collapsed');
    }

    let autoHideTimeout;
    function resetAutoHideTimer() {
      clearTimeout(autoHideTimeout);
      autoHideTimeout = setTimeout(hideSidebar, 15000);
    }

    resetAutoHideTimer();
    sidebar.addEventListener('mouseenter', resetAutoHideTimer);
    sidebar.addEventListener('mouseleave', resetAutoHideTimer);

    toggleSidebar.addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
      content.classList.toggle('collapsed');
      resetAutoHideTimer();
    });

    // Auto-submit form on file selection
    const fileInput = document.getElementById('fileInput');
    const uploadForm = document.getElementById('uploadForm');

    fileInput.addEventListener('change', function () {
      if (fileInput.files.length > 0) {
        uploadForm.submit();
      }
    });
  </script>
</body>
</html>